server {
    listen 8080;
    server_name _;
    location = /health/live { access_log off; return 200 'ok'; }
    location / { return 308 ${PUBLIC_ORIGIN}$request_uri; }
}
server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 201m;
    client_body_timeout 120s;
    include /etc/nginx/snippets/security-headers.conf;
    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;
    location /api/ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control no-store;
    }
    location /health/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        access_log off;
    }
    location /_protected/ {
        internal;
        alias /storage/;
        max_ranges 1;
        sendfile on;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control no-store always;
    }
    location /static/ { alias /srv/static/; }
    location /assets/ { include /etc/nginx/snippets/security-headers.conf; try_files $uri =404; expires 1y; add_header Cache-Control "public, immutable"; }
    location /pdfjs/ { try_files $uri =404; expires 1d; }
    location = /index.html { include /etc/nginx/snippets/security-headers.conf; add_header Cache-Control no-cache; }
    location / { try_files $uri $uri/ /index.html; }
}
